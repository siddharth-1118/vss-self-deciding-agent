# Archil credentials for the `disk` CLI and the Node.js `disk` library.
# Copy this file to `.env` (or `.env.local`), fill in your own values, and
# never commit it. The real file is gitignored.
#
# Get an API key by creating an Archil account at:
#   https://console.archil.com/
#
# Required:
ARCHIL_API_KEY=
# Region whose compute is closest to where your work runs. Serverless `exec`
# is AWS-only today; valid choices are:
#   aws-us-east-1, aws-us-west-2, aws-eu-west-1
ARCHIL_REGION=aws-us-east-1
